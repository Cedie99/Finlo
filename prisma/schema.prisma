generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // App relations
  creditCards            CreditCard[]
  installmentPlans       InstallmentPlan[]
  preferences            UserPreference?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CreditCard {
  id               String   @id @default(cuid())
  userId           String
  bankName         String
  cardName         String
  lastFourDigits   String?
  creditLimit      Decimal  @db.Decimal(12, 2)
  currentBalance   Decimal  @default(0) @db.Decimal(12, 2)
  billingCycleDay  Int
  dueDayOffset     Int      @default(20)
  color            String   @default("#6366f1")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  installmentPlans InstallmentPlan[]

  @@index([userId])
}

enum InstallmentType {
  CREDIT_CARD
  LOAN
  BNPL
}

enum InstallmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  PAUSED
}

model InstallmentPlan {
  id             String            @id @default(cuid())
  userId         String
  creditCardId   String?
  name           String
  description    String?
  type           InstallmentType
  status         InstallmentStatus @default(ACTIVE)
  totalAmount    Decimal           @db.Decimal(12, 2)
  monthlyAmount  Decimal           @db.Decimal(12, 2)
  totalMonths    Int
  paidMonths     Int               @default(0)
  startDate      DateTime
  nextDueDate    DateTime?
  interestRate   Decimal?          @db.Decimal(5, 4)
  lenderName     String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard CreditCard?          @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  payments   InstallmentPayment[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, nextDueDate])
}

model InstallmentPayment {
  id                String   @id @default(cuid())
  installmentPlanId String
  amount            Decimal  @db.Decimal(12, 2)
  dueDate           DateTime
  paidDate          DateTime?
  isPaid            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  installmentPlan InstallmentPlan @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)

  @@index([installmentPlanId])
  @@index([installmentPlanId, isPaid])
}

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  minimumCashBuffer  Decimal? @db.Decimal(12, 2)
  bufferPercentage   Decimal  @default(10) @db.Decimal(5, 2)
  paydayDaysOfMonth  Int[]    @default([15])
  enableDailyDigest  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
